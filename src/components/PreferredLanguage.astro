---
import { defaultLocale, languagePreferenceKey, localeUrl, locales } from '../lib/i18n';

interface Props {
  redirectToPage: boolean;
}
const { redirectToPage } = Astro.props;
const localeUrls = Object.fromEntries(locales.map(locale => [locale, localeUrl(locale)]));
---
<script is:inline data-astro-rerun define:vars={{ defaultLocale, languagePreferenceKey, locales, localeUrls, redirectToPage }}>
  // Resolve before rendering; 404 pages keep their original URL and status.
  const requested = new URLSearchParams(window.location.search).get('lang');
  let saved;
  try {
    saved = window.localStorage.getItem(languagePreferenceKey);
  } catch {}
  const supported = value => locales.includes(value);
  const browserLanguage = navigator.languages
    .map(language => language.toLowerCase().split('-')[0])
    .find(supported);
  const preferred = supported(requested) ? requested : supported(saved) ? saved : browserLanguage || defaultLocale;
  document.documentElement.dataset.preferredLocale = preferred;
  // Search crawlers render as English browsers. Redirecting only from the
  // English root keeps every language page indexable at its own URL.
  // Redirect only when the page is opened, not on page swaps that rerun this
  // script or on history traversal, so the Back button can reach the English
  // page.
  const opening = document.readyState === 'loading'
    && performance.getEntriesByType('navigation')[0]?.type !== 'back_forward';
  if (redirectToPage && opening && preferred !== defaultLocale) {
    window.location.replace(`${localeUrls[preferred]}${window.location.search}${window.location.hash}`);
  }
</script>
