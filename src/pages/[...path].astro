---
import Document from '../layouts/Document.astro';
import About from '../views/about';
import { locales, localeUrl, messages, type Locale } from '../lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { path: locale === 'en' ? 'en' : undefined },
    props: { locale },
  }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const location = {
  pathname: localeUrl(locale),
};

---
<Document pageType="about" title={messages[locale].pageTitle} locale={locale}>
  <About location={location} locale={locale} data={{}} client:load />
</Document>
