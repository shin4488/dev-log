---
import Document from '../layouts/Document.astro';
import About from '../views/about';
import { localeUrl, messages, type Locale } from '../lib/i18n';

export function getStaticPaths() {
  return (['ja', 'en'] as const).flatMap((locale) =>
    [undefined, 'about'].map((path) => ({
      params: { path: locale === 'en' ? ['en', path].filter(Boolean).join('/') : path },
      props: { locale, pagePath: path ? `/${path}/` : '/' },
    })),
  );
}
interface Props { locale: Locale; pagePath: string }
const { locale, pagePath } = Astro.props;
const location = {
  pathname: localeUrl(locale, pagePath),
};

---
<Document pageType="about" title={messages[locale].pageTitle} locale={locale} pagePath={pagePath}>
  <About location={location} locale={locale} data={{}} client:load />
</Document>
