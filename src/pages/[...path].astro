---
import Document from '../layouts/Document.astro';
import About from '../views/about';
import { localUrl } from '../lib/site';

export function getStaticPaths() {
  return [undefined, 'about'].map((path) => ({ params: { path } }));
}
const location = {
  pathname: localUrl(`/${Astro.params.path ? Astro.params.path + '/' : ''}`),
};

---
<Document pageType="about" title="About">
  <About location={location} data={{}} client:load />
</Document>
