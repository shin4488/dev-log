---
import Document from '../../layouts/Document.astro';
import NotFound from '../../views/404';
import { messages, localeUrl } from '../../lib/i18n';
---
<Document pageType="not_found" title={messages.en.notFoundTitle} locale="en" pagePath="/404/">
  <NotFound location={{ pathname: localeUrl('en', '/404/') }} locale="en" data={undefined as never} client:load />
</Document>
